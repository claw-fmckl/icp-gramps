type Person = record {
  handle : text;
  gramps_id : text;
  gender : int64;
  given_names : text;
  call_name : opt text;
  surname : text;
  suffix : opt text;
  title_text : opt text;
  birth_ref_handle : opt text;
  death_ref_handle : opt text;
  private : bool;
  change_date : int64;
  created_at : int64;
};

type PersonInput = record {
  gender : int64;
  given_names : text;
  call_name : opt text;
  surname : text;
  suffix : opt text;
  title_text : opt text;
  private : opt bool;
};

type Event = record {
  handle : text;
  gramps_id : text;
  event_type : text;
  place_handle : opt text;
  place_text : opt text;
  date_sortval : opt int64;
  date_text : opt text;
  description : text;
  private : bool;
  change_date : int64;
  created_at : int64;
};

type EventInput = record {
  event_type : text;
  place_handle : opt text;
  place_text : opt text;
  date_sortval : opt int64;
  date_text : opt text;
  description : opt text;
  private : opt bool;
};

type Family = record {
  handle : text;
  gramps_id : text;
  father_handle : opt text;
  mother_handle : opt text;
  family_type : text;
  private : bool;
  change_date : int64;
  created_at : int64;
};

type FamilyInput = record {
  father_handle : opt text;
  mother_handle : opt text;
  family_type : opt text;
  private : opt bool;
};

type Place = record {
  handle : text;
  gramps_id : text;
  title : text;
  name : text;
  place_type : text;
  latitude : opt float64;
  longitude : opt float64;
  code : opt text;
  private : bool;
  change_date : int64;
  created_at : int64;
};

type PlaceInput = record {
  title : text;
  name : opt text;
  place_type : opt text;
  latitude : opt float64;
  longitude : opt float64;
  code : opt text;
  private : opt bool;
};

service : {
  http_request : (record { url : text; method : text; headers : vec record { text; text }; body : vec nat8 }) -> (record { status_code : nat16; headers : vec record { text; text }; body : vec nat8; upgrade : opt bool }) query;
  http_request_update : (record { url : text; method : text; headers : vec record { text; text }; body : vec nat8 }) -> (record { status_code : nat16; headers : vec record { text; text }; body : vec nat8; upgrade : opt bool });
  list_persons : () -> (vec Person) query;
  get_person : (text) -> (opt Person) query;
  create_person : (PersonInput) -> (opt Person);
  update_person : (text, PersonInput) -> (opt Person);
  delete_person : (text) -> (bool);
  create_event : (EventInput) -> (opt Event);
  update_event : (text, EventInput) -> (opt Event);
  delete_event : (text) -> (bool);
  get_event : (text) -> (opt Event) query;
  set_person_birth : (text, EventInput) -> (opt Event);
  set_person_death : (text, EventInput) -> (opt Event);
  get_person_birth : (text) -> (opt Event) query;
  get_person_death : (text) -> (opt Event) query;
  list_places : () -> (vec Place) query;
  get_place : (text) -> (opt Place) query;
  search_places : (text) -> (vec Place) query;
  create_place : (PlaceInput) -> (opt Place);
  update_place : (text, PlaceInput) -> (opt Place);
  delete_place : (text) -> (bool);
  list_families : () -> (vec Family) query;
  get_family : (text) -> (opt Family) query;
  create_family : (FamilyInput) -> (opt Family);
  update_family : (text, FamilyInput) -> (opt Family);
  delete_family : (text) -> (bool);
  add_child_to_family : (text, text, text, text) -> (bool);
  remove_child_from_family : (text, text) -> (bool);
  get_family_children : (text) -> (vec Person) query;
  get_person_parent_families : (text) -> (vec Family) query;
  get_person_own_families : (text) -> (vec Family) query;
};
